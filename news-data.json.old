[{"date": "2026-10-20","title": "新华社权威AI时政资讯智能体“新华语典”正式上线","summary": "新华社权威AI时政资讯智能体“新华语典”正式上线","source": "新华网","sourceUrl": "https://www.news.cn/20260626/d404d2120f0a40cab266a51efbf565bb/c.html","category": "AI"},{"date": "2026-10-20","title": "吴清最新发言八大要点：谈中国资产、市场稳定和AI浪潮","summary": "吴清最新发言八大要点：谈中国资产、市场稳定和AI浪潮","source": "澎湃新闻","sourceUrl": "https://www.thepaper.cn/newsDetail_forward_34282373","category": "AI"},{"date": "2026-10-20","title": "针对DeepSeek，美国政府下黑手","summary": "针对DeepSeek，美国政府下黑手","source": "新浪新闻","sourceUrl": "https://news.sina.com.cn/c/2026-10-19/doc-inivurkf6097386.shtml","category": "AI"},{"date": "2026-10-20","title": "四个谷歌 Gemini 4 Argon 智能体成功击败末影龙通关《我的世界》，耗时 27 小时","summary": "IT之家 10 月 19 日消息，谷歌研究人员近日发布论文称，他们使用四个 Gemini 4 Argon 智能体成功通关《我的世界》，仅用 27 小时就成功击败末影龙。谷歌将 4 个 Gemini 4 放入随机生成的世界中，他们可以通过游戏内的聊天框互相协调。但研究人员没有为他们制定任何策略，只是说了最终目标，所有行为都由智能体自行规划。研究人员可通过仪表板观察他们，下达暂停 /...","source": "IT之家","sourceUrl": "https://www.ithome.com/1/015/048.htm","category": "AI"},{"date": "2026-10-20","title": "2026 年三季度印度智能手机市场遇冷，iPhone 销量下滑 20%","summary": "IT之家 10 月 19 日消息，市场调研机构 Omdia 数据显示，2026 年第三季度，印度全国智能手机出货量同比下降 26%，创下过去 10 年同期最低水平。尽管苹果 iPhone 在印度的销量同比下滑 20%，但与竞争对手相比，其表现仍相对稳健。据悉，印度消费者的消费支出趋于保守，与新机涨价叠加在一起，该国智能手机总出货量降至 3580...","source": "IT之家","sourceUrl": "https://www.ithome.com/1/015/042.htm","category": "AI"},{"date": "2026-10-20","title": "全新深蓝 S05 新增智能生态仪表屏：4.39 英寸 OLED，显示核心行车信息","summary": "IT之家 10 月 19 日消息，深蓝汽车官方发布，全新深蓝 S05 新增智能生态仪表屏。此前，深蓝 S05 仅提供 AR-HUD 抬头显示，智能生态仪表屏采用 4.39 英寸 OLED 屏，信息一目了然。IT之家注意到，全新深蓝 S05 车型于今年 8 月上市，共推出 5 款车型，售价区间 11.99-15.19 万元，限时优惠价 11.59-14.49...","source": "IT之家","sourceUrl": "https://www.ithome.com/1/015/041.htm","category": "AI"},{"date": "2026-10-20","title": "商务部：今年 1-9 月，重点平台智能眼镜销售额增长 1.1 倍","summary": "IT之家 10 月 19...","source": "IT之家","sourceUrl": "https://www.ithome.com/1/015/038.htm","category": "AI"},{"date": "2026-10-20","title": "古尔曼：苹果正研发室内摄像头，依靠 AI 分析环境","summary": "IT之家 10 月 19 日消息，彭博社记者马克 · 古尔曼在最新一期《Power On》通讯中提到，苹果正在研发一款室内摄像头，内部代号 J450，可利用 AI...","source": "IT之家","sourceUrl": "https://www.ithome.com/1/015/023.htm","category": "AI"},{"date": "2026-10-20","title": "苹果收购 AI 音频编辑公司 Samplab，有望为 Logic Pro 引入更精细的音频编辑功能","summary": "IT之家 10 月 19 日消息，据外媒 Appleinsider 报道，苹果已收购瑞士苏黎世 AI 音频编辑公司 Samplab，根据收购交易清单，苹果将收购 Samplab 的部分资产，并向该公司部分员工提供工作机会。公开信息显示，Samplab 于 2020 年在瑞士苏黎世成立，创始人为 Manuel Fritsche 和 Gian-Marco...","source": "IT之家","sourceUrl": "https://www.ithome.com/1/015/005.htm","category": "AI"},{"date": "2026-10-20","title": "今年上半年我国人形机器人产量超 4 万台，预计全年将突破 10 万台","summary": "IT之家 10 月 19 日消息，国务院新闻办公室今日举行新闻发布会，介绍加快推进科技兴商有关情况，并答记者问。会上介绍，具身智能是人工智能从“数字世界”走进“物理世界”的关键载体，正在成为培育新质生产力的重要抓手。工业和信息化部推动以人形机器人为代表的具身智能产业实现三个“加速”。一是规模体量加速壮大。今年上半年，我国人形机器人整机产品突破 400 款，产量超 4 万台，预计全年将突破 10...","source": "IT之家","sourceUrl": "https://www.ithome.com/1/015/002.htm","category": "AI"},{"date": "2026-10-20","title": "国产 AI 历史模拟新游《崇祯模拟器 Demo》上架 Steam，免费试玩","summary": "IT之家 10 月 19 日消息，个人开发者 ZHANG HANLIANG 制作的国产历史策略模拟游戏《崇祯模拟器 Demo》现已登陆 Steam 平台开启试玩，完整支持简体中文界面、字幕与音频。IT之家附游戏商品页（https://store.steampowered.com/app/5121940/）。崇祯十七年，大明风雨飘摇 ——...","source": "IT之家","sourceUrl": "https://www.ithome.com/1/014/977.htm","category": "AI"},{"date": "2026-10-20","title": "36氪报告图解 | 《2026年中国AI Agent行业发展研究报告》","summary": "2026年，随着基础模型能力持续成熟、推理成本下降，AI的价值重心正在从“简单对话”转向“决策执行”。AI Agent以大模型为决策大脑，集成环境感知、长期记忆、规划推理与工具调用能力，能够在较少人工干预下自主理解目标、拆解任务、调用工具并交付结果，当前AI Agent市场已从概念验证迈向生产力验证。 近期，36氪研究院发布了《2026年中国AI...","source": "36氪","sourceUrl": "<![CDATA[https://36kr.com/p/4032427409609096?f=rss]]>","category": "AI"},{"date": "2026-10-20","title": "聚焦在轨服务，要打造太空机器人集群，「国宇星辰」完成近亿元A轮融资｜36氪首发","summary": "文 | 阿至 商业航天的叙事，正在从“把卫星送上天”过渡至“卫星上天后”怎么管、怎么运营。 除了组网建设加速，一个直观的信号是，低轨星座的补网压力也正在逼近。根据NASA戈达德航天中心此前发布的研究数据，2020至2024年间，有583颗星链卫星从极低地球轨道坠落。而为了防止失控与碰撞，卫星的主动变轨和避让动作也变得愈发频繁。根据SpaceX...","source": "36氪","sourceUrl": "<![CDATA[https://36kr.com/p/4032195238482313?f=rss]]>","category": "AI"},{"date": "2026-10-20","title": "2连板海洋王：AI+智慧照明业务收入规模有限","summary": "36氪获悉，海洋王发布异动公告，公司AI+智慧照明相关业务属于公司“照明+”战略下的布局，公司依托自有移动摄像照明产品，通过AI视觉识别算法挖掘现场数据价值打造智能仓储、智慧工地等行业定制方案。目前阶段该类收入规模有限，对公司整体业绩尚不构成重大影响，请广大投资者谨慎决策，注意投资风险。","source": "36氪","sourceUrl": "<![CDATA[https://36kr.com/newsflashes/4032782692308104?f=rss]]>","category": "AI"},{"date": "2026-10-20","title": "智元联合NVIDIA及多所高校推出世界模型评测平台WorldOracle","summary": "36氪获悉，智元、NVIDIA及多所高校研究人员联合开发的世界模型评测平台WorldOracle正式上线，并开放评测提交。该平台采用335条真实操作轨迹，约四成交互片段包含失败或次优操作，以真实执行结果检验模型预测能力。对7款世界模型的测试发现，部分模型虽能较准确还原机械臂动作，但对物体状态的预测仍存在较大偏差，长时序预测表现也明显下降。","source": "36氪","sourceUrl": "<![CDATA[https://36kr.com/newsflashes/4032758104429449?f=rss]]>","category": "AI"},{"date": "2026-10-20","title": "微软回应退出Nscale英国数据中心项目：仍维持合作关系","summary": "算力租赁服务商Nscale（新一代云服务商）上周末披露，微软已撤回对其伦敦附近在建数据中心项目的合作承诺。原因在于：该站点可能还要数年才能接入电网。微软退出的举动，再度引发市场担忧，全球如火如荼的AI基础设施建设热潮潜藏风险。Nscale与微软试图淡化上述担忧。Nscale一名代表表示：“我们仍致力于推进劳顿项目以及在英国的布局，正在为该项目寻找替代电源方案。”微软发言人称：“我们仍维持与Nsca...","source": "36氪","sourceUrl": "<![CDATA[https://36kr.com/newsflashes/4032746406908808?f=rss]]>","category": "AI"},{"date": "2026-10-20","title": "今年我国人形机器人整机产品产量预计将突破10万台！工信部：将深挖民生等领域重点场景需求，形成一批标杆应用","summary": "今年我国人形机器人整机产品产量预计将突破10万台！工信部：将深挖民生等领域重点场景需求，形成一批标杆应用","source": "每日经济新闻","sourceUrl": "https://www.nbd.com.cn/articles/2026-10-19/4608754.html","category": "AI"},{"date": "2026-10-20","title": "AI走向失控？这次的“吹哨人”为什么是数学家 | 每经对话三位菲尔兹奖得主","summary": "AI走向失控？这次的“吹哨人”为什么是数学家 | 每经对话三位菲尔兹奖得主","source": "每日经济新闻","sourceUrl": "https://www.nbd.com.cn/articles/2026-09-30/4595675.html","category": "AI"},{"date": "2026-10-20","title": "专访研究团队还原“失控智能体”访问高德3.5万次背后：用了被泄露的密钥，还给人类发来感谢信，运营者已不知AI在做什么","summary": "专访研究团队还原“失控智能体”访问高德3.5万次背后：用了被泄露的密钥，还给人类发来感谢信，运营者已不知AI在做什么","source": "每日经济新闻","sourceUrl": "https://www.nbd.com.cn/articles/2026-10-16/4606803.html","category": "AI"},{"date": "2026-10-20","title": "研究报告称大批AI智能体“盯上”高德地图：3.5万次访问请求，但未发现入侵行为","summary": "研究报告称大批AI智能体“盯上”高德地图：3.5万次访问请求，但未发现入侵行为","source": "每日经济新闻","sourceUrl": "https://www.nbd.com.cn/articles/2026-10-15/4605650.html","category": "AI"},{"date": "2026-10-20","title": "AI信贷的第一颗“雷”出现了？英伟达“亲儿子”CoreWeave债券收益率突破15%，吓坏马斯克！分析师：若无力偿还债务，股权价值将归零","summary": "AI信贷的第一颗“雷”出现了？英伟达“亲儿子”CoreWeave债券收益率突破15%，吓坏马斯克！分析师：若无力偿还债务，股权价值将归零","source": "每日经济新闻","sourceUrl": "https://www.nbd.com.cn/articles/2026-10-15/4605548.html","category": "AI"},{"date": "2026-10-20","title": "谷歌在芬兰130亿欧元投资引发抗议，砍掉530公顷森林后，两座数据中心被叫停，监管部门称未完成环境评估就开工","summary": "谷歌在芬兰130亿欧元投资引发抗议，砍掉530公顷森林后，两座数据中心被叫停，监管部门称未完成环境评估就开工","source": "每日经济新闻","sourceUrl": "https://www.nbd.com.cn/articles/2026-10-14/4604092.html","category": "AI"},{"date": "2026-10-20","title": "口碑榜舆情筛选收官，大数据模型筛选接棒：从“合规排雷”转向“价值成色”大考","summary": "口碑榜舆情筛选收官，大数据模型筛选接棒：从“合规排雷”转向“价值成色”大考","source": "每日经济新闻","sourceUrl": "https://www.nbd.com.cn/articles/2026-10-19/4608138.html","category": "AI"},{"date": "2026-10-20","title": "【焦点复盘】沪指低开高走涨0.39%，物理AI概念异军突起，工行重夺总市值“一哥”","summary": "①连板晋级率不足三成，连板高度降至三连板，高位股亏钱效应再度释放，新华文轩、读者传媒、金健米业等多股跌停。 ②英伟达GTC大会举行在即，物理AI、人形机器人等相关板块爆发，人形机器人龙头宇树科技大涨16%，总市值重返2000亿上方。","source": "财联社","sourceUrl": "https://www.cls.cn/detail/2508604","category": "AI"},{"date": "2026-10-20","title": "【每日收评】创业板指缩量震荡跌近1%，机器人概念股全线爆发，工行、建行再创新高","summary": "①今日市场呈现震荡分化，三大指数涨跌不一，沪指小幅收红，创业板再度跌近1%，其中人形机器人概念强势领涨，银行股维持强势，工行、建设再创新高； ②高位股延续分化走势，澳弘电子走出反包涨停，录得21天12板，百洋股份、阳光乳业、新经典等2连跌停。","source": "财联社","sourceUrl": "https://www.cls.cn/detail/2508559","category": "AI"},{"date": "2026-10-20","title": "英伟达GTC柏林大会即将开幕 黄仁勋将发表主题演讲 AI工厂、欧洲投资引关注","summary": "①黄仁勋将在21日发表主题演讲； ②Vera Rubin平台的实际部署进展或成为关键看点； ③除了技术，英伟达在欧洲的战略布局值得关注。","source": "财联社","sourceUrl": "https://www.cls.cn/detail/2508118","category": "AI"},{"date": "2026-10-20","title": "【明日主题前瞻】大厂密集发布Agent产品，智能体赛道竞争白热化","summary": "①大厂密集发布Agent产品，智能体赛道竞争白热化；②国产卫星互联网首次实现地球三极联网通信；③电池技术主要发展方向之一，固态电池成为“兵家必争之地”。","source": "财联社","sourceUrl": "https://www.cls.cn/detail/2508456","category": "AI"},{"date": "2026-10-20","title": "低价突围AI算力赛道：芯片企业Tenstorrent估值翻倍至62亿美元","summary": "①Tenstorrent完成15亿美元E轮融资，估值升至62亿美元，较2024年翻倍有余； ②据报道，公司今年曾与英特尔、高通洽谈收购，最终选择融资独立发展； ③公司CEO吉姆·凯勒称，市场正在寻找替代方案，公司可凭借更低价格和定制化服务参与竞争。","source": "财联社","sourceUrl": "https://www.cls.cn/detail/2508882","category": "AI"},{"date": "2026-10-20","title": "不超过374.9亿元！千亿算力龙头全资子公司签署算力云服务协议|盘后公告集锦","summary": "骏亚科技：Q3净利润环比增长620% PCB产品订单金额增加","source": "财联社","sourceUrl": "https://www.cls.cn/detail/2508877","category": "AI"},{"date": "2026-10-20","title": "物理AI迎来专用存储器？美光自曝正研发EIM","summary": "①美光科技副总裁李哲透露，该公司正在研发专为物理AI应用而设计的边缘推理存储器（EIM）。 ②业内人士预计，该产品将于2028年下半年实现量产。 ③在李哲看来，HBM最终将被应用于人形机器人。","source": "财联社","sourceUrl": "https://www.cls.cn/detail/2508635","category": "AI"},{"date": "2026-10-20","title": "前三季度深圳集成电路等人工智能相关零部件进出口规模居全国首位","summary": "前三季度深圳集成电路等人工智能相关零部件进出口规模居全国首位","source": "证券时报","sourceUrl": "https://www.stcn.com/article/detail/4224927.html","category": "AI"},{"date": "2026-10-20","title": "集体大涨！华尔街重磅发声，AI暴跌虚惊一场？","summary": "集体大涨！华尔街重磅发声，AI暴跌虚惊一场？","source": "证券时报","sourceUrl": "https://www.stcn.com/article/detail/4226608.html","category": "AI"},{"date": "2026-10-20","title": "近375亿元算力大单！300857，最新公告","summary": "近375亿元算力大单！300857，最新公告","source": "证券时报","sourceUrl": "https://www.stcn.com/article/detail/4226492.html","category": "AI"},{"date": "2026-10-20","title": "跌出机会？机器人ETF霸榜涨幅榜，但资金还在观望？","summary": "跌出机会？机器人ETF霸榜涨幅榜，但资金还在观望？","source": "证券时报","sourceUrl": "https://www.stcn.com/article/detail/4225889.html","category": "AI"},{"date": "2026-10-20","title": "世界模型评测平台WorldOracle发布","summary": "世界模型评测平台WorldOracle发布","source": "证券时报","sourceUrl": "https://www.stcn.com/article/detail/4226633.html","category": "AI"},{"date": "2026-10-20","title": "人民鉴真184期丨慈文传媒：公司AIGC平台尚未形成相关收入","summary": "人民鉴真184期丨慈文传媒：公司AIGC平台尚未形成相关收入","source": "证券时报","sourceUrl": "https://www.stcn.com/article/detail/4226542.html","category": "AI"},{"date": "2026-10-20","title": "西安奕材三季报扭亏为盈！AI需求拉动12英寸硅片供需趋紧 涨价订单锁定2027年量价","summary": "西安奕材三季报扭亏为盈！AI需求拉动12英寸硅片供需趋紧 涨价订单锁定2027年量价","source": "证券时报","sourceUrl": "https://www.stcn.com/article/detail/4226614.html","category": "AI"},