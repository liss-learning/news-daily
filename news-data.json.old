[{"date": "2026-08-14", "title": "Anthropic计划10月以2万亿美元估值IPO上市，有望超SpaceX成全球最大IPO", "summary": "《财富》报道称Anthropic计划2026年10月以2万亿美元估值IPO上市，其规模将超过SpaceX成为史上规模最大的IPO。Anthropic旗下Claude系列模型在AI领域持续领先。", "source": "IT之家", "sourceUrl": "https://www.ithome.com/0/989/505.htm", "category": "AI"}, {"date": "2026-08-14", "title": "OpenAI年化营收超400亿美元，备战IPO上市", "summary": "彭博社报道OpenAI公司在IPO上市前年化营收已超过400亿美元，有望在2026年翻番。OpenAI持续巩固其全球AI领导者地位。", "source": "IT之家", "sourceUrl": "https://www.ithome.com/0/989/490.htm", "category": "AI"}, {"date": "2026-08-14", "title": "OpenAI推Ultrafast模式：GPT-5.6 Sol AI提速14倍，每秒生成750个词元", "summary": "OpenAI发布公告宣布以预览形式针对其最强AI模型GPT-5.6 Sol推出Ultrafast超高速模式，是标准处理速度的14倍，最高每秒输出750个词元。", "source": "IT之家", "sourceUrl": "https://www.ithome.com/0/989/492.htm", "category": "AI"}, {"date": "2026-08-14", "title": "谷歌推出Gemini 3.7 Flash模型，专为编程与Agents场景打造", "summary": "谷歌宣布推出Gemini 3.7 Flash模型，专为编程与Agents场景打造，首发优惠价为原3.6 Flash的一半，大幅降低AI推理成本。", "source": "IT之家", "sourceUrl": "https://www.ithome.com/0/989/497.htm", "category": "AI"}, {"date": "2026-08-14", "title": "Mac版ChatGPT新增Computer History AI功能，不再依赖截图记录活动", "summary": "OpenAI发布Computer History功能，为Mac版ChatGPT桌面应用提供活动记忆与时间线支持，取代先前的Chronicle研究预览功能。", "source": "IT之家", "sourceUrl": "https://www.ithome.com/0/989/518.htm", "category": "AI"}, {"date": "2026-08-14", "title": "DeepSeek正式涨价！算力供需缺口凸显，国产AI芯片或迎价值重估", "summary": "DeepSeek正式公布调价方案，V4-Pro高峰时段输出价格最高涨至27元。机构指出API价格上调是供需矛盾的直接证据，算力紧缺仍具确定性，国产AI芯片有望在价值重估中核心受益。", "source": "东方财富", "sourceUrl": "https://finance.eastmoney.com/a/202608143840965939.html", "category": "AI"}, {"date": "2026-08-14", "title": "神秘生图模型mona-lisa-1曝光：含OpenAI来源信号", "summary": "该模型在AI竞技场盲测中被发现，经OpenAI内容验证工具检测出OpenAI来源信号，此前GPT-Image 2发布前也曾以匿名形式测试，暗示OpenAI可能即将推出新图像生成模型。", "source": "IT之家", "sourceUrl": "https://www.ithome.com/0/989/476.htm", "category": "AI"}, {"date": "2026-08-14", "title": "7月美国企业AI消费观察：GPT-5.6 Sol收入超Anthropic Fable 5", "summary": "Ramp追踪七万余家美国企业AI支出发现，7月Anthropic顶级模型支出仅为OpenAI对应产品的75%，但Anthropic企业采用率仍领先，整体企业AI支出正快速增长。", "source": "IT之家", "sourceUrl": "https://www.ithome.com/0/989/208.htm", "category": "AI"}, {"date": "2026-08-14", "title": "报告称90%高管认为AI未提升公司生产力，部分企业召回被裁员工", "summary": "科技媒体informationweek报道，在AI冲击导致全球科技行业裁员潮背景下，部分企业开始回头召回被裁员工。AI生产力提升效果仍存争议。", "source": "IT之家", "sourceUrl": "https://www.ithome.com/0/989/181.htm", "category": "AI"}, {"date": "2026-08-14", "title": "美国对进口无人机及零部件征收最高100%关税", "summary": "美国白宫发表声明称，总统特朗普签署公告以应对国家安全威胁为由，对进口无人机及零部件征收10%至100%的从价关税。", "source": "东方财富", "sourceUrl": "https://finance.eastmoney.com/a/202608143840872285.html", "category": "财经"}, {"date": "2026-08-14", "title": "交易员不再百分百定价美联储今年会加息，降息预期升温", "summary": "随着油价回落强化市场对美国通胀降温前景的乐观情绪，利率交易员周四终于不再完全定价美联储今年会加息。对于9月议息会议，市场认为按兵不动的概率高达68%。", "source": "东方财富", "sourceUrl": "https://finance.eastmoney.com/a/202608143841162269.html", "category": "财经"}, {"date": "2026-08-14", "title": "央行二季度货币政策执行报告释放新信号：前瞻性灵活性针对性增强", "summary": "中国银河证券首席宏观分析师张迪认为，下一阶段货币政策将更加强调前瞻发力并保持灵活，在宏观政策中率先发力稳就业、稳企业、稳市场、稳预期。", "source": "东方财富", "sourceUrl": "https://finance.eastmoney.com/a/202608143840841664.html", "category": "财经"}, {"date": "2026-08-14", "title": "华西证券：算力与基础设施是当前最清晰的投资主线", "summary": "华西证券研报指出三条投资主线：算力与基础设施受益确定性最强；具备行业数据壁垒的垂直大模型企业有望率先实现商业闭环；拥有庞大用户基数的平台型企业将随商业化成熟逐步显现。", "source": "东方财富", "sourceUrl": "https://finance.eastmoney.com/a/202608143841105030.html", "category": "财经"}, {"date": "2026-08-14", "title": "华泰证券：算力升级下AI电源呈现四大趋势", "summary": "华泰证券研报称在从Scale out走向Scale up的AI超节点机柜趋势下，AIDC功率密度迎来非线性增长，800V直流方案有望从优选走向必选，国内外800V产业化齐头并进。", "source": "东方财富", "sourceUrl": "https://finance.eastmoney.com/a/202608143841064517.html", "category": "财经"}, {"date": "2026-08-14", "title": "中芯国际三季度收入预计环比增长2%到4%，华虹宏力预计环比增长8%", "summary": "中芯国际公告2026年Q2销售收入30亿美元，环比增长20%，毛利率25.3%。Q3收入预计环比增长2%到4%。展望下半年，AI产业推动与溢出效应还将持续，为集成电路制造带来广泛需求。", "source": "东方财富", "sourceUrl": "https://finance.eastmoney.com/a/202608143840890948.html", "category": "科技"}, {"date": "2026-08-14", "title": "宇树科技IPO申购倍数超8000倍，具身智能赛道引关注", "summary": "宇树科技科创板IPO发行结果显示网上初步有效申购倍数约8288.82倍。评论指出资本市场既要仰望未来星空也要立足产业现实支撑，技术落地和产业变现进程更为关键。", "source": "东方财富", "sourceUrl": "https://finance.eastmoney.com/a/202608143840840056.html", "category": "科技"}, {"date": "2026-08-14", "title": "闪迪亮出财务蓝图：2030年前毛利率看向80%，投后剩余现金100%回馈股东", "summary": "闪迪公布财务蓝图规划，目标2030年前毛利率达到80%，投后剩余现金100%回馈股东，存储芯片行业景气度持续向好。", "source": "东方财富", "sourceUrl": "https://finance.eastmoney.com/a/202608143840845244.html", "category": "科技"}, {"date": "2026-08-14", "title": "部分Claude模型将添加文本水印，Anthropic回应各界关切", "summary": "部分Claude模型会直接在输出文本中嵌入难以察觉的水印，内容被复制粘贴后水印仍会随文本保留。用于帮助判断一段文字是否由AI生成，响应欧盟AI法案透明度要求。", "source": "IT之家", "sourceUrl": "https://www.ithome.com/0/989/462.htm", "category": "自媒体"}, {"date": "2026-08-14", "title": "DeepSeek Harness公测：对标Claude Cowork，同步开放插件生态", "summary": "DeepSeek发布Harness产品公测，对标Claude Cowork，同步开放配套插件生态。V4-Pro模型参数量达1.6万亿，权重已采用MIT许可证开放，可适配国产GPU降低私有化部署门槛。", "source": "IT之家", "sourceUrl": "https://www.ithome.com/0/989/446.htm", "category": "AI"}, {"date": "2026-08-14", "title": "谷歌AI重组内幕曝光：布林不满落后Anthropic，要求全力投入Gemini", "summary": "谷歌联合创始人布林近几个月来敦促关键AI部门员工全力投入Gemini模型，Alphabet正寻求缩小与竞争对手Anthropic的差距。", "source": "IT之家", "sourceUrl": "https://www.ithome.com/0/989/035.htm", "category": "AI"}, {"date": "2026-08-14", "title": "腾讯微信公布WeLM大模型：80B版已在小微应用，617B版开发中", "summary": "腾讯微信团队公布由微信团队打造的大语言模型WeLM，以资源利用效率为核心。80B版本已在AI助手小微上应用，更大规模的617B版本正在开发中。", "source": "IT之家", "sourceUrl": "https://www.ithome.com/0/989/007.htm", "category": "AI"}, {"date": "2026-08-14", "title": "中国美协儿童图画书大展一作品被指AI生成，工作人员回应已撤下", "summary": "一幅名为《把夏天装进书包》的作品在山东美术馆展出，因儿童手指扭曲、六指等明显AI生成特征被举报。中国美协回应称已取消该作品入展资格，AI创作边界争议持续。", "source": "IT之家", "sourceUrl": "https://www.ithome.com/0/989/183.htm", "category": "自媒体"}, {"date": "2026-08-14", "title": "谷歌DeepMind推出手语转文本AI模型，首次进入消费级", "summary": "谷歌DeepMind推出手语转文本模型，谷歌Pixel 11系列智能手机上的Gboard和Live Transcribe应用支持手语转文本输入，听力障碍人士可享受类似语音输入的灵活体验。", "source": "IT之家", "sourceUrl": "https://www.ithome.com/0/989/105.htm", "category": "科技"}, {"date": "2026-08-14", "title": "Mistral AI开放第三方模型接入：首个为智谱GLM-5.2", "summary": "Mistral AI宣布自家平台开放第三方模型接入，首个接入的第三方模型为中国智谱GLM-5.2。用户可选择在美国或欧洲区域执行推理负载，满足数据跨境合规要求。", "source": "IT之家", "sourceUrl": "https://www.ithome.com/0/989/031.htm", "category": "AI"}, {"date": "2026-08-13", "title": "DeepSeek V4 Pro正式版深夜发布，API已上线，多项测试性能接近Fable 5", "summary": "DeepSeek V4 Pro正式版（DeepSeek-V4-Pro-0813）深夜发布，已更新至API。新版本增强Agent能力，支持Responses API和Codex接入，在多项测试中接近Fable 5水平，相比预览版能力大幅提升。", "source": "IT之家", "sourceUrl": "https://www.ithome.com/0/989/000.htm", "category": "AI"}, {"date": "2026-08-13", "title": "DeepSeek官网API文档新增V4-Pro-0813模型，支持非思考与思考模式", "summary": "DeepSeek官网API文档的模型与价格页面中，新增DeepSeek-V4-Pro-0813模型，支持非思考与思考模式。此前官方曾承诺V4-Pro正式版将尽快发布。", "source": "IT之家", "sourceUrl": "https://www.ithome.com/0/988/998.htm", "category": "AI"}, {"date": "2026-08-13", "title": "DeepSeek梁文锋财富一年暴涨3850%，增速登顶全球亿万富豪榜", "summary": "过去一年全球亿万富翁身价报告显示，DeepSeek创始人梁文锋财富飙升3850%，增速居全球首位。DeepSeek估值在3250亿至3500亿元区间。", "source": "IT之家", "sourceUrl": "https://www.ithome.com/0/988/273.htm", "category": "AI"}, {"date": "2026-08-13", "title": "传智教育13天9板后紧急提示风险：已被交易所重点监控，或停牌核查", "summary": "传智教育公告称股价近期上涨过快，13天累计涨幅达136.01%，已被深交所重点监控。AI应用端盘中震荡拉升，传智教育再度涨停，近13个交易日累计收获9个涨停。", "source": "东方财富", "sourceUrl": "https://finance.eastmoney.com/a/202608133839791393.html", "category": "财经"}, {"date": "2026-08-13", "title": "MSCI中国指数季度调整：MLCC龙头风华高科、智谱等33只标的被纳入", "summary": "MSCI公布2026年8月指数季度调整结果，MSCI中国指数新纳入33只标的，包括铜冠铜箔、风华高科、芯源微等31只A股，以及智谱和建滔集团两只港股。调整将于8月31日收盘后生效。", "source": "东方财富", "sourceUrl": "https://finance.eastmoney.com/a/202608133839982663.html", "category": "财经"}, {"date": "2026-08-13", "title": "美国7月CPI数据今晚公布，全球市场屏息以待通胀走向", "summary": "全球金融市场聚焦今晚发布的美国7月CPI数据。市场预期通胀继续回落，若数据低于预期将进一步强化美联储降息预期，对全球资产定价产生重大影响。", "source": "东方财富", "sourceUrl": "https://finance.eastmoney.com/a/202608123839135870.html", "category": "财经"}, {"date": "2026-08-13", "title": "荣耀Robot Phone正式发布：9999元起，首发钛合金云台影像与YOYO Pro模式", "summary": "荣耀正式发布Robot Phone手机，定价9999元起。搭载骁龙8 Elite Gen5处理器、7060mAh电池，首发钛合金云台影像架构与荣耀驭光H1自研芯片，支持YOYO Pro智能模式。", "source": "IT之家", "sourceUrl": "https://www.ithome.com/0/988/961.htm", "category": "科技"}, {"date": "2026-08-13", "title": "小米澎湃HyperOS 4系统蓄势待发，REDMI产品经理透露在路上了", "summary": "小米澎湃HyperOS 4系统离正式发布越来越近，REDMI产品经理胡馨心透露新系统Beta版已在路上。新特性包括大量实时光场渲染、玻璃材质、堆叠桌面小组件、AI感色融色UI等。", "source": "IT之家", "sourceUrl": "https://www.ithome.com/0/988/839.htm", "category": "科技"}, {"date": "2026-08-13", "title": "小米雷军：第四代pTSF是中国首创的底层显示技术方案", "summary": "小米董事长雷军宣布第四代pTSF像素级薄膜开关技术为中国首创的底层显示技术方案，在屏幕响应速度和功耗控制方面实现突破，有望应用于下一代旗舰手机和折叠屏设备。", "source": "IT之家", "sourceUrl": "https://www.ithome.com/0/988/780.htm", "category": "科技"}, {"date": "2026-08-13", "title": "A股三大指数集体收涨，创业板指涨1.49%超4100只个股飘红", "summary": "8月12日A股三大指数集体收涨，创业板指涨1.49%，超4100只个股飘红。市场情绪明显回暖，通信、半导体等科技板块领涨，量化策略在风格均衡环境下超额收益有望改善。", "source": "东方财富", "sourceUrl": "https://finance.eastmoney.com/a/202608123839129195.html", "category": "量化"}, {"date": "2026-08-13", "title": "20%涨停！16亿封单抢筹，硬科技板块彻底燃爆", "summary": "硬科技板块掀起涨停潮，多只个股20%涨停，封单资金高达16亿元。在AI算力需求和国产替代双重驱动下，硬科技赛道成为资金主攻方向，量化资金加速涌入。", "source": "东方财富", "sourceUrl": "https://finance.eastmoney.com/a/202608123838995882.html", "category": "量化"}, {"date": "2026-08-13", "title": "美国政府设备封禁3年后重新允许使用TikTok", "summary": "美国政府在封禁3年后正式重新允许政府设备使用TikTok。这一政策逆转标志着TikTok在美合规运营取得重大进展，也为全球短视频平台的监管博弈提供了新范例。", "source": "东方财富", "sourceUrl": "https://finance.eastmoney.com/a/202608123838814256.html", "category": "自媒体"}, {"date": "2026-08-13", "title": "索尼宣布为国产游戏《影之刃零》举办专属State of Play发布会", "summary": "索尼宣布为国产游戏《影之刃零》举办专属State of Play发布会，将展示近20分钟实机内容。这是索尼首次为中国游戏举办专属发布会，国产游戏全球影响力持续攀升。", "source": "IT之家", "sourceUrl": "https://www.ithome.com/0/988/770.htm", "category": "自媒体"}, {"date": "2026-08-13", "title": "Counterpoint：华为继续领跑中国智能手机市场，前30周销量稳居第一", "summary": "Counterpoint最新数据显示2026年前30周中国智能手机销量同比下降8.6%，但华为继续领跑市场。华为凭借鸿蒙生态和AI能力持续巩固高端市场优势。", "source": "IT之家", "sourceUrl": "https://www.ithome.com/0/988/823.htm", "category": "自媒体"}, {"date": "2026-08-13", "title": "Y Combinator CEO陈嘉兴：善用AI智能体的创业者将提前活在2028年", "summary": "YC CEO陈嘉兴谈及AI智能体时表示，你得直接把强度拉满，一次给它100万个token。到了这种程度，你基本上就能提前活在2028年。", "source": "IT之家", "sourceUrl": "https://www.ithome.com/0/989/366.htm", "category": "AI"}, {"date": "2026-08-13", "title": "辛顿、李飞飞、吴恩达齐发声：呼吁保持AI一定程度的开放", "summary": "三位AI行业教父教母在Ai4大会上讨论AI开放性问题。具体解决方案虽然各不相同，但三人都提出了充分理由，认为AI仍需要保持一定程度的开放。", "source": "IT之家", "sourceUrl": "https://www.ithome.com/0/989/245.htm", "category": "AI"}, {"date": "2026-08-13", "title": "OpenAI奥尔特曼：6个月内AI将实现完美理解用户使用情境", "summary": "OpenAI CEO Sam Altman表示在未来6个月时间里，OpenAI的后续AI模型将具备完美理解用户使用情境功能，AI交互体验将迎来质的飞跃。", "source": "IT之家", "sourceUrl": "https://www.ithome.com/0/989/234.htm", "category": "AI"}, {"date": "2026-08-13", "title": "阿里千问开放平台上线菜鸟智能体，协助用户规划寄件方案", "summary": "阿里千问开放平台上线菜鸟智能体，可根据用户寄件需求匹配最优寄件方案与快递公司，还能解答寄件疑问、补全收寄信息，让寄件更省心。", "source": "IT之家", "sourceUrl": "https://www.ithome.com/0/989/126.htm", "category": "AI"}, {"date": "2026-08-12", "title": "OpenAI测试ChatGPT Plus付费重置额度功能，8美元恢复使用额度", "summary": "OpenAI正在测试ChatGPT Plus付费重置额度功能，用户可支付8美元恢复使用额度。此举被解读为OpenAI探索多元商业化路径的信号，AI订阅服务进入精细化运营阶段。", "source": "IT之家", "sourceUrl": "https://www.ithome.com/0/988/773.htm", "category": "AI"}, {"date": "2026-08-12", "title": "华为启动AIPL基线合作伙伴计划，联合打造可复制的AI实践教学方案", "summary": "华为正式启动AIPL基线合作伙伴计划，联合高校和产业伙伴打造可复制、可规模化推广的AI实践教学方案，推动AI人才培养体系标准化建设。", "source": "IT之家", "sourceUrl": "https://www.ithome.com/0/988/804.htm", "category": "AI"}, {"date": "2026-08-12", "title": "中信证券：字节跳动成立AI数据部门，版权数据价值重估", "summary": "中信证券研报指出字节跳动已成立AI数据部门，专注AI训练数据资产管理。此举标志着科技巨头对高质量训练数据的争夺进入新阶段，版权数据价值面临重估。", "source": "东方财富", "sourceUrl": "https://finance.eastmoney.com/a/202608123838516913.html", "category": "AI"}, {"date": "2026-08-12", "title": "但斌回应质疑：对AI从未动摇，依旧满仓坚守", "summary": "东方港湾董事长但斌回应市场质疑，表示没有恐慌割肉、没有大幅减仓，对AI投资方向从未动摇，依旧满仓坚守。其坚定态度引发市场对AI板块后市走向的广泛讨论。", "source": "东方财富", "sourceUrl": "https://finance.eastmoney.com/a/202608123838537517.html", "category": "AI"}, {"date": "2026-08-12", "title": "芝商所计划于10月推出算力期货，AI算力进入金融化交易时代", "summary": "芝加哥商品交易所(CME)计划于2026年10月推出算力期货合约，这将是全球首个标准化的算力金融衍生品。AI算力从基础设施走向金融化交易，标志着AI产业成熟度进入新阶段。", "source": "东方财富", "sourceUrl": "https://topic.eastmoney.com/detail/zsstcslqh.html", "category": "AI"}, {"date": "2026-08-12", "title": "龙头业绩爆表！通信设备强势拉升，融资客最新抢筹股曝光", "summary": "通信设备龙头业绩超预期，板块强势拉升。融资客最新抢筹方向集中在AI算力产业链，通信设备、光模块、服务器等细分赛道获资金集中配置，量化策略跟踪信号强烈。", "source": "东方财富", "sourceUrl": "https://finance.eastmoney.com/a/202608123838994610.html", "category": "量化"}, {"date": "2026-08-12", "title": "中报大幕拉开！QFII、社保、券商等机构最新重仓股曝光", "summary": "A股中报季正式拉开帷幕，QFII、社保基金、券商等机构最新重仓股浮出水面。机构持仓变动为量化因子模型提供了新的数据维度，风格轮动策略迎来配置窗口。", "source": "东方财富", "sourceUrl": "https://finance.eastmoney.com/a/202608123838322692.html", "category": "量化"}, {"date": "2026-08-12", "title": "腾讯控股半年报：归母净利润1141.15亿元，同比增长10%", "summary": "腾讯控股发布2026财年半年报，归母净利润1141.15亿元，同比增长10%。第二季度营收2048亿元，同比增长11%。游戏、广告和企业服务三大业务板块均实现稳健增长。", "source": "IT之家", "sourceUrl": "https://www.ithome.com/0/988/829.htm", "category": "财经"}, {"date": "2026-08-12", "title": "网传英伟达欲投资中际旭创、新易盛？公司紧急回应", "summary": "市场传闻英伟达拟投资中国光模块龙头中际旭创和新易盛，引发股价异动。相关公司紧急回应称目前未收到英伟达投资意向，但承认双方在业务层面有深度合作。", "source": "东方财富", "sourceUrl": "https://finance.eastmoney.com/a/202608123838992246.html", "category": "财经"}, {"date": "2026-08-12", "title": "樊纲：房地产市场已出现较为快速的价格出清", "summary": "著名经济学家樊纲表示中国房地产市场已出现较为快速的价格出清，部分城市房价调整幅度已超过30%。他认为市场正在经历必要的调整过程，房地产行业有望逐步企稳。", "source": "东方财富", "sourceUrl": "https://finance.eastmoney.com/a/202608123838966177.html", "category": "财经"}, {"date": "2026-08-12", "title": "中金：建议继续超配黄金，金价有望企稳回升", "summary": "中金公司发布研报建议继续超配黄金资产，认为在全球流动性预期改善、地缘风险持续和美元走弱三重因素支撑下，金价有望企稳回升。", "source": "东方财富", "sourceUrl": "https://finance.eastmoney.com/a/202608123838527518.html", "category": "财经"}, {"date": "2026-08-12", "title": "集邦咨询：全固态电池进入工程验证期，技术成熟度已有重大进展", "summary": "集邦咨询最新报告指出全固态电池技术已进入工程验证期，在能量密度、循环寿命和安全性方面取得重大进展。预计2027-2028年将迎来规模化量产，新能源汽车产业格局面临重塑。", "source": "IT之家", "sourceUrl": "https://www.ithome.com/0/988/778.htm", "category": "科技"}, {"date": "2026-08-12", "title": "凯迪拉克全新XT5 PHEV首发量产Momenta R7世界模型，配激光雷达", "summary": "凯迪拉克全新XT5 PHEV正式首发，成为首款量产搭载Momenta R7世界模型的车型，配备激光雷达和蜂鸟底盘。端到端自动驾驶方案从高端车型向主流市场渗透加速。", "source": "IT之家", "sourceUrl": "https://www.ithome.com/0/988/786.htm", "category": "科技"}, {"date": "2026-08-12", "title": "中信证券：存储产业保持高景气度，后续关注LTA进展与股东回报", "summary": "中信证券研报指出存储产业保持高景气度，HBM和NAND Flash需求持续旺盛。SK海力士重启中国NAND闪存生产基地2号工厂建设，产能将扩大约50%。", "source": "东方财富", "sourceUrl": "https://finance.eastmoney.com/a/202608123838529495.html", "category": "科技"}, {"date": "2026-08-12", "title": "国产算力基建加速落地！阿里云超节点实例上线，后续拟扩至多地域", "summary": "阿里云超节点实例正式上线，为国产算力基础设施建设的重要里程碑。该实例面向大规模AI训练场景，后续拟扩展至多个地域，国产AI算力供给能力大幅提升。", "source": "东方财富", "sourceUrl": "https://finance.eastmoney.com/a/202608123839106149.html", "category": "科技"}, {"date": "2026-08-11", "title": "OpenAI暂缓Astra模型研发，下一代AI模型能力逼近危险边界", "summary": "OpenAI宣布暂缓其下一代Astra大模型部分研发工作，因其在漏洞挖掘、自主攻击等安全测试中表现出人意料的能力。CEO奥特曼表示安全是首要原则。", "source": "香港商报", "sourceUrl": "https://hkcd.com/hkcdweb/content/2026/08/08/content_8768755.html", "category": "AI"}, {"date": "2026-08-11", "title": "中国国产大模型全球总下载量突破100亿次，海外影响力持续攀升", "summary": "最新数据显示中国国产大模型全球累计下载量突破100亿次，在非洲、东南亚、印度等新兴市场渗透率快速增长。", "source": "海外网", "sourceUrl": "https://biz.haiwainet.cn/n/2026/0807/c3545092-32973828.html", "category": "AI"}, {"date": "2026-08-11", "title": "字节跳动梁汝波：坚持自研大语言模型，接受短期落后", "summary": "字节跳动CEO梁汝波表示尽管豆包大模型与海外顶级模型存在差距，公司坚持自研路线。AI仍是字节未来十年最重要的基础设施级投入。", "source": "每经网", "sourceUrl": "http://www.nbd.com.cn/articles/2026-08-06/4534064.html", "category": "AI"}, {"date": "2026-08-11", "title": "中国大模型八周五连发，硅谷企业悄悄换底座", "summary": "中国大模型在八周内完成五次重量级发布，硅谷企业开始采用中国开源模型替换原有底座。", "source": "证券时报", "sourceUrl": "https://stcn.com/article/detail/4066017.html", "category": "AI"}, {"date": "2026-08-11", "title": "动量Beta因子大幅走弱，8月量化修复可期", "summary": "近期动量因子和Beta因子表现大幅走弱，传统量化选股模型面临挑战。但8月市场风格有望回归均衡，量化策略修复行情可期。", "source": "中国财经信息网", "sourceUrl": "https://wt.cfi.cn/p20260810002688.html", "category": "量化"}, {"date": "2026-08-11", "title": "监管基础设施平权重塑量化生态，全市场选股策略优势凸显", "summary": "监管推进行情数据基础设施平权，局域网通道关停后所有机构站在同一起跑线。全市场选股策略优势凸显。", "source": "网易财经", "sourceUrl": "https://www.163.com/dy/article/L3ISGVUQ051987V2.html", "category": "量化"}, {"date": "2026-08-11", "title": "首尾差超20%！量化超额大分化，头部与腰部差距持续拉大", "summary": "8月以来公募量化产品超额收益首尾差距超过20个百分点，头部机构凭借更成熟的多因子模型和另类数据源持续领跑。", "source": "中国证券报", "sourceUrl": "https://www.cnstock.com/commonDetail/755665", "category": "量化"}, {"date": "2026-08-11", "title": "英伟达联手高盛、黑石等六巨头，筹建超5000亿美元AI计算基础设施融资平台", "summary": "英伟达联手高盛、黑石等六家金融巨头拟筹建超5000亿美元的AI计算基础设施融资平台，标志着AI算力基础设施投资进入全新量级。", "source": "中国证券报", "sourceUrl": "https://www.cnstock.com/commonDetail/758025", "category": "财经"}, {"date": "2026-08-11", "title": "多重稳市信号释放，资本市场着力强韧性、提信心", "summary": "监管层密集释放多重稳市信号：政策工具箱充足、经济基本面稳固、外资机构看好中国资产。多部门协同发力形成稳预期合力。", "source": "财联社", "sourceUrl": "https://www.cls.cn/detail/2450663", "category": "财经"}, {"date": "2026-08-11", "title": "Power Integrations推出2200V氮化镓技术，创商用领域最高电压纪录", "summary": "Power Integrations发布面向新一代高压电力系统的2200V氮化镓技术，创下商用领域最高电压纪录。标志着GaN功率半导体进入高压大功率应用新纪元。", "source": "电子产品世界", "sourceUrl": "https://m.eepw.com.cn/article/202608/482789.html", "category": "科技"}, {"date": "2026-08-11", "title": "基本半导体与汉磊科技达成战略合作，加速8英寸碳化硅晶圆量产", "summary": "基本半导体与汉磊科技合作推进8英寸碳化硅晶圆的研发与量产落地，加速SiC器件在新能源汽车和光伏逆变器中的大规模应用。", "source": "观点网", "sourceUrl": "https://www.guandian.hk/article/20260805/580820.html", "category": "科技"}, {"date": "2026-08-11", "title": "视频生成模型跃迁，AI微短剧进入质胜时代", "summary": "AI微短剧从概念验证进入商业量产阶段。制作周期已从数月缩短至3天，行业从卷数量转向卷质量，精品化趋势明显。", "source": "央广网", "sourceUrl": "https://news.qq.com/rain/a/20260807A0EFTQ00", "category": "自媒体"}, {"date": "2026-08-11", "title": "AI女孩打通短剧商业化闭环，虚拟演员商单报价超真人网红", "summary": "AI虚拟演员方桃子一条广告报价高达25.8万元超过同粉丝量级真人网红博主，标志着AI虚拟IP商业化路径初步跑通。", "source": "中华工商时报", "sourceUrl": "http://epaper.cbt.com.cn/epaper/uniflows/html/2026/08/10/04/04_53.htm", "category": "自媒体"}, {"date": "2026-08-11", "title": "视频生成模型正在争夺什么？AI创作进入生态级博弈阶段", "summary": "视频生成模型领域竞争全面升级，各大厂从工具级竞争升级到生态级博弈，AI视频赛道进入技术、生态和商业化的全方位比拼阶段。", "source": "36氪", "sourceUrl": "https://www.36kr.com/p/3930236944596099", "category": "自媒体"}, {"date": "2026-08-10", "title": "AI微短剧大揭秘：泼天富贵还是虚假繁荣？", "summary": "北京日报深度调查AI微短剧行业现状：头部玩家日收入可达数万元，但95%的制作者月收入不足5000元。AI降低了制作门槛但抬高了爆款门槛，行业呈现出明显的赢家通吃格局。", "source": "北京日报", "sourceUrl": "https://xinwen.bjd.com.cn/content/s6a71e5d1e4b03fa51a827d6d.html", "category": "自媒体"}, {"date": "2026-08-10", "title": "阿里发布Qwen3.8-Max：2.4万亿参数开源大模型，推理成本降至行业1/8", "summary": "阿里巴巴正式发布Qwen3.8-Max模型，总参数量达2.4万亿，在编程、推理和多模态理解方面全面跃升。该模型推理成本降至行业的1/8。", "source": "中关村在线", "sourceUrl": "https://ai.zol.com.cn/1226/12268657.html", "category": "AI"}, {"date": "2026-08-10", "title": "大模型开源激活Token经济：生成式AI从技术竞赛走向商业落地", "summary": "随着国内大模型持续开源，Token经济正被激活成为新增长引擎。AI推理成本已降至行业均值的1/8，企业应用门槛大幅降低。", "source": "人民邮电报", "sourceUrl": "https://www.cnii.com.cn/rmydb/202608/t20260807_753587.html", "category": "AI"}, {"date": "2026-08-10", "title": "一个月跌去30%再反弹13%：极端行情下公募量化如何构筑护城河", "summary": "7月极端行情中公募量化产品回撤高达30%，随后5天快速反弹13%。管理人在波动加剧中调整风控模型、引入波动率自适应机制。", "source": "中国基金报", "sourceUrl": "https://www.chnfund.com/article/AR20260809101415005", "category": "量化"}, {"date": "2026-08-10", "title": "交易所关停局域网行情通道后，量化行业面临的六大变化", "summary": "沪深交易所全面关停局域网行情通道后，市场关注六大核心变化：高频策略容量大幅压缩、Tick级数据获取受限、策略同质化有望缓解。", "source": "财联社", "sourceUrl": "https://api3.cls.cn/share/article/2447060", "category": "量化"}, {"date": "2026-08-10", "title": "局域网行情通道关闭满月：量化高频遇减速带，A股成交量回落", "summary": "局域网行情通道关停满月，8月A股日均成交量较7月均值回落约15%。高频量化策略容量大幅压缩，部分私募转战中低频策略。", "source": "证券日报", "sourceUrl": "http://www.zqdb.com.cn/xinwen/2026/show-1261660.html", "category": "量化"}, {"date": "2026-08-10", "title": "外资机构密集发声：AI资本开支拐点隐现，科技股估值逻辑面临重构", "summary": "高盛、摩根士丹利、瑞银等外资机构密集发布研究报告，认为全球AI资本开支增速已接近阶段性峰值。AI从重资本投入阶段转向商业化变现阶段。", "source": "证券时报", "sourceUrl": "https://stcn.com/article/detail/4060669.html", "category": "财经"}, {"date": "2026-08-10", "title": "美股标普500指数再创新高，疲软非农缓解加息担忧", "summary": "美国8月非农就业数据表现疲软，大幅缓解市场对美联储加息的担忧。美股三大指数集体收涨，标普500指数再创历史新高，大型科技股普涨。", "source": "东方财富", "sourceUrl": "https://fund.eastmoney.com/a/202608083835598562.html", "category": "财经"}, {"date": "2026-08-10", "title": "国家能源局：加大关键电力装备自主研发，推动电力芯片关键技术突破", "summary": "国家能源局发布指导意见，明确加大关键电力装备自主研发力度，重点推动电力芯片、特高压组部件、新型储能材料等关键技术突破。", "source": "IT之家", "sourceUrl": "https://www.ithome.com/0/986/922.htm", "category": "科技"}, {"date": "2026-08-10", "title": "台积电等研发出单层MoS2顶栅晶体管，二维半导体迈出关键一步", "summary": "台积电联合学术界成功研发出基于单层二硫化钼(MoS2)的顶栅晶体管，解决了二维半导体材料从实验室走向量产的关键工艺瓶颈。该成果有望突破硅基芯片物理极限。", "source": "财联社", "sourceUrl": "https://www.cls.cn/detail/2448108", "category": "科技"}, {"date": "2026-08-10", "title": "AI微短剧重构影视生态：打造智能经济新形态", "summary": "经济日报分析指出AI微短剧正重构影视生态，从拍摄、后期到宣发全链路AI化。2026年上半年AI微短剧市场规模突破50亿元。", "source": "经济日报", "sourceUrl": "http://www.jingjiribao.cn/static/detail.jsp?id=674084", "category": "自媒体"}, {"date": "2026-08-10", "title": "AI+微短剧重构影视生态：爆款率不足0.5%困局待解", "summary": "AI微短剧虽火热但爆款率不足0.5%，大量作品同质化严重。行业面临三大挑战：内容创意不足、平台算法推荐马太效应加剧、版权归属争议。", "source": "财联社", "sourceUrl": "https://api3.cls.cn/share/article/2445817", "category": "自媒体"}, {"date": "2026-08-10", "title": "60秒广告报价25.8万：AI虚拟偶像商业价值超越真人，造星产业爆发", "summary": "AI虚拟演员商业价值持续飙升，60秒广告报价已达25.8万元超越内娱待爆艺人。品牌方对AI代言人的接受度快速提升，AI造星产业从概念验证进入商业化运营新阶段。", "source": "36氪", "sourceUrl": "https://36kr.com/p/3924696277514368", "category": "自媒体"}, {"date": "2026-08-10", "title": "当AI把门槛降低，创作者拿什么拼出人味儿？行业深度反思核心竞争力", "summary": "AI技术大幅降低内容创作门槛后，创作者的核心竞争力从技术操作转向审美判断和情感表达。在AI内容泛滥的当下，人味儿和真情实感成为稀缺资源。", "source": "36氪", "sourceUrl": "https://36kr.com/p/3924517757565056", "category": "自媒体"}, {"date": "2026-08-10", "title": "大模型迈入物理世界！端侧AI元年开启，手机汽车抢占智能体入口", "summary": "2026年被业界定义为端侧AI元年，大模型正从云端走向物理世界。手机和汽车成为AI智能体的核心入口，端侧推理芯片需求爆发式增长。", "source": "东方财富", "sourceUrl": "https://finance.eastmoney.com/a/202608053831681647.html", "category": "AI"}, {"date": "2026-08-10", "title": "市场风格回归均衡，指增策略配置窗口已打开，超额环境明显改善", "summary": "最新量化策略报告指出市场风格正从极端分化回归均衡，指数增强策略超额收益环境明显改善。在成交缩量和贴水中等分位的背景下，指增策略配置窗口已经打开。", "source": "中国财经信息网", "sourceUrl": "https://vipwt1.cfi.net.cn/p20260803001577.html", "category": "量化"}, {"date": "2026-08-10", "title": "3万亿量化遭遇压力测试：阿尔法贝塔罕见双杀，洗牌之后迎新开局", "summary": "管理规模超3万亿的量化私募行业正经历阿尔法和贝塔罕见双杀的压力测试。在风格频繁切换、成交缩量和监管趋严三重压力下，行业进入深度洗牌阶段。", "source": "证券时报", "sourceUrl": "https://stcn.com/article/detail/4060906.html", "category": "量化"}, {"date": "2026-08-10", "title": "AI漫剧爆火，内容创作别只剩情绪", "summary": "AI漫剧近期爆火但行业反思认为内容创作不应只剩情绪。行业共识：技术效率不能替代内容品质和情感共鸣。", "source": "百度百家", "sourceUrl": "https://baijiahao.baidu.com/s?id=1873118219471767684", "category": "自媒体"}, {"date": "2026-08-10", "title": "资本跑步入场，真人短剧与AI漫剧此消彼长背后发生了什么", "summary": "真人短剧与AI漫剧两大品类此消彼长引发行业深度关注。资本正加速涌入AI漫剧赛道，制作成本仅为传统短剧十分之一但变现难题依然突出。", "source": "东方财富", "sourceUrl": "https://finance.eastmoney.com/a/202608043831135328.html", "category": "自媒体"}, {"date": "2026-08-09", "title": "3万亿量化遭遇压力测试：阿尔法贝塔罕见双杀，洗牌之后迎新开局", "summary": "管理规模超3万亿的量化私募行业正经历阿尔法和贝塔罕见双杀的压力测试。在风格频繁切换、成交缩量和监管趋严三重压力下，行业进入深度洗牌阶段。", "source": "证券时报", "sourceUrl": "https://stcn.com/article/detail/4060906.html", "category": "量化"}, {"date": "2026-08-09", "title": "美媒深度报道：当非洲和印度企业大规模采用中国AI大模型", "summary": "美国媒体深度报道指出非洲和印度企业正加速转向中国AI大模型，成本仅为美国竞品的十分之一。中国开源模型凭借高性价比和灵活部署方案在新兴市场建立强大影响力。", "source": "新浪新闻", "sourceUrl": "https://news.sina.com.cn/zx/gj/2026-08-07/doc-inimneni4153301.shtml", "category": "AI"}, {"date": "2026-08-09", "title": "阿里Qwen3.8正式上线：总参数量2.4万亿，第三方榜单仅次于Claude", "summary": "阿里巴巴正式上线Qwen3.8大模型，总参数量达2.4万亿，在第三方权威榜单中综合排名仅次于Claude。该模型在编程、推理和多模态理解方面实现全面跃升。", "source": "澎湃新闻", "sourceUrl": "https://m.thepaper.cn/newsDetail_forward_33708536", "category": "AI"}, {"date": "2026-08-09", "title": "基本半导体上市后再落一子，8英寸碳化硅晶圆布局持续深化", "summary": "基本半导体(09971.HK)上市后持续深化8英寸碳化硅晶圆布局，股价涨超4%获市场积极反馈。公司通过自建产线和战略合作双轮驱动模式推进SiC晶圆产业化。", "source": "EET-CHINA", "sourceUrl": "https://www.eet-china.com/mp/a514884.html", "category": "科技"}, {"date": "2026-08-09", "title": "2家SiC企业合作推进8寸晶圆线，碳化硅产业链国产化全面提速", "summary": "国内碳化硅产业链国产化全面提速，两家SiC企业宣布合作共同推进8英寸晶圆产线建设。在AI数据中心供电和新能源汽车双轮驱动下，SiC功率半导体需求井喷。", "source": "EET-CHINA", "sourceUrl": "https://www.eet-china.com/mp/a514776.html", "category": "科技"}, {"date": "2026-08-09", "title": "全球流动性收紧节奏暂缓，券商研判下半年或出现边际改善", "summary": "多家券商发布最新研判认为全球流动性收紧节奏出现暂缓迹象，下半年A股市场或出现边际改善。美国通胀超预期回落缓解加息压力。", "source": "中国金融信息网", "sourceUrl": "https://www.cnfin.com/dz-lb/detail/20260807/4452003_1.html", "category": "财经"}, {"date": "2026-08-09", "title": "风格轮动策略月报：8月建议超配大盘风格和价值风格，微盘长期看好", "summary": "最新风格轮动策略月报建议8月超配大盘风格和价值风格。微盘股估值处于历史低位长期看好，但在市场结构变化背景下大小盘风格切换可能加速。", "source": "新浪财经", "sourceUrl": "https://stock.finance.sina.com.cn/stock/go.php/vReport_Show/kind/11/rptid/839261226836/index.phtml", "category": "量化"}, {"date": "2026-08-09", "title": "京东开源自研JoyAI-Video-Edit模型，视频生成模型暗战全面升温", "summary": "京东宣布开源自研JoyAI-Video-Edit视频编辑模型，字节、MiniMax等厂商也争相亮剑，视频生成模型领域暗战全面升温。", "source": "每日经济新闻", "sourceUrl": "http://www.nbd.com.cn/articles/2026-08-05/4533139.html", "category": "自媒体"}, {"date": "2026-08-08", "title": "AI接连攻克数学难题，从辅助工具升级为独立科研参与者", "summary": "AI在数学推理领域接连攻克多个长期未解难题，OpenAI Astra以2000美元算力破解十项数学难题。AI正从辅助工具升级为独立科研参与者。", "source": "科技日报", "sourceUrl": "https://www.stdaily.com/web/gdxw/2026-08/04/content_559112.html", "category": "AI"}, {"date": "2026-08-08", "title": "三星zHBM与BV-NAND原型亮相，晶圆键合实现十倍存储密度提升", "summary": "三星电子推出zHBM高带宽存储器和BV-NAND闪存原型产品，采用晶圆键合技术实现存储密度十倍提升。该技术突破面向AI数据中心和HPC场景。", "source": "搜狐科技", "sourceUrl": "https://www.sohu.com/a/1058923054_115362", "category": "科技"}, {"date": "2026-08-08", "title": "中国大模型调用量连续十四周领跑全球，AI主题指数强势涨超4%", "summary": "最新数据显示中国AI大模型周均调用量已连续十四周领跑全球，人工智能主题指数强势涨超4%。从开源模型到应用层全链路领先。", "source": "中国证券报", "sourceUrl": "https://www.cnstock.com/commonDetail/754369", "category": "AI"}, {"date": "2026-08-08", "title": "AI大模型价格战拉崩亚洲科技股？行业进入成本效率竞争新阶段", "summary": "AI大模型价格战持续白热化对亚洲科技股估值产生深远影响。OpenAI、Meta大幅压低API价格，国产模型以极致性价比应对，行业竞争从参数规模转向成本效率和商业落地能力。", "source": "证券时报", "sourceUrl": "https://stcn.com/article/detail/4054866.html", "category": "AI"}, {"date": "2026-08-08", "title": "阿里港股突现六大利好，Qwen3.8发布带动中国AI资产重估", "summary": "阿里巴巴发布Qwen3.8大模型后港股突现六大利好信号。算力需求持续扩容、AI应用生态全面爆发、外资重新评估中国AI资产价值。", "source": "证券时报", "sourceUrl": "https://stcn.com/article/detail/4054863.html", "category": "AI"}, {"date": "2026-08-08", "title": "快手入局AI互动内容，大厂抢滩下一代内容入口", "summary": "快手正式入局AI互动内容赛道，成为继腾讯、抖音之后又一家全面押注AI互动内容的大型平台。AI互动内容被视为继短视频之后的下一波内容形态变革。", "source": "搜狐新闻", "sourceUrl": "https://news.sohu.com/a/1058275923_122014422", "category": "自媒体"}, {"date": "2026-08-08", "title": "告别脸崩时代！AI视频生成模型竞赛加速，商业化闭环仍是最大挑战", "summary": "AI视频生成技术取得重大突破彻底告别早期脸崩时代。各大厂商模型竞赛全面加速，从创业公司到科技巨头纷纷加码。", "source": "21世纪经济报道", "sourceUrl": "https://m.21jingji.com/article/20260803/herald/7080ea30f6479008240f11500bc75b3b.html", "category": "自媒体"}, {"date": "2026-08-08", "title": "蔚来以AI质检加自研芯片双轮驱动，车芯自研成新能源车企核心竞争力", "summary": "安徽车企蔚来深度布局自研芯片和AI质检技术，以技术创新双轮驱动发展。蔚来在智能驾驶芯片、车规MCU和AI视觉检测等领域持续加大投入。", "source": "东方财富", "sourceUrl": "https://fund.eastmoney.com/a/202608053832572866.html", "category": "科技"}, {"date": "2026-08-08", "title": "交易所关停局域网行情通道后，市场最关注六大变化", "summary": "交易所关停局域网行情通道后市场出现六个显著变化：成交量结构性收缩、高频策略容量受限、中小量化机构加速洗牌、中长期资金占比提升。", "source": "东方财富", "sourceUrl": "https://finance.eastmoney.com/news/1344,202608063833689154.html", "category": "量化"}, {"date": "2026-08-08", "title": "黄金股抢跑，金价重返4300美元后还能走多远", "summary": "国际金价强势重返4300美元关口上方，黄金股应声大涨抢跑。疲软非农数据加剧美元走弱预期，叠加全球地缘风险升温，避险资金持续涌入黄金资产。", "source": "证券时报", "sourceUrl": "https://egs.stcn.com/news/detail/2324575.html", "category": "财经"}, {"date": "2026-08-08", "title": "美股标普500指数再创新高，疲软非农缓解加息担忧", "summary": "美国8月非农就业数据表现疲软，大幅缓解市场对美联储加息的担忧。美股三大指数集体收涨，标普500指数再创历史新高，大型科技股普涨。", "source": "东方财富", "sourceUrl": "https://fund.eastmoney.com/a/202608083835598562.html", "category": "财经"}, {"date": "2026-08-08", "title": "8月A股市场走向再平衡，从科技成长到红利消费均衡切换", "summary": "多家机构指出8月A股市场正走向再平衡。前期科技股抱团松动后市场主线从科技成长向红利消费均衡切换，配置逻辑回归基本面定价。", "source": "金融投资报", "sourceUrl": "https://stocknews.scol.com.cn/shtml/jrtzb/20260808/1086385.html", "category": "财经"}, {"date": "2026-08-08", "title": "供给约束预期升温，资源品市场表现活跃", "summary": "全球供给约束预期持续升温推动资源品市场表现活跃。能源、有色金属和农产品等大宗商品价格走高，资源股和周期股受到资金追捧。", "source": "证券时报", "sourceUrl": "https://egs.stcn.com/news/detail/2324575.html", "category": "财经"}, {"date": "2026-08-08", "title": "市场风格回归均衡，指增超额逐渐趋好，配置窗口已打开", "summary": "最新量化策略报告指出市场风格正从极端分化回归均衡，指数增强策略超额收益环境明显改善。在成交缩量和贴水中等分位的背景下，指增策略配置窗口已经打开。", "source": "新浪财经", "sourceUrl": "https://stock.finance.sina.com.cn/stock/go.php/vReport_Show/kind/lastest/rptid/839084110122/index.phtml", "category": "量化"}, {"date": "2026-08-08", "title": "A股量化择时研究：AI识图关注红利低波、现金流、价值方向", "summary": "最新A股量化择时研究报告运用AI图像识别技术进行市场状态分析，当前建议关注红利低波、现金流充沛和价值风格标的。", "source": "新浪财经", "sourceUrl": "https://stock.finance.sina.com.cn/stock/go.php/vReport_Show/kind/11/rptid/839012460227/index.phtml", "category": "量化"}]