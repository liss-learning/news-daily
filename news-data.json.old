[{"date": "2026-08-31","title": "与中国同行，共赴智能未来","summary": "与中国同行，共赴智能未来","source": "新华网","sourceUrl": "https://www.news.cn/20260721/b447e6b709774806aff90d648dfa4162/c.html","category": "AI"},{"date": "2026-08-31","title": "新华社权威AI时政资讯智能体“新华语典”正式上线","summary": "新华社权威AI时政资讯智能体“新华语典”正式上线","source": "新华网","sourceUrl": "https://www.news.cn/20260626/d404d2120f0a40cab266a51efbf565bb/c.html","category": "AI"},{"date": "2026-08-31","title": "消息称字节跳动豆包大模型 2.2 将推迟发布，原计划 8 月推出","summary": "IT之家 8 月 30 日消息，据白鲸实验室消息，字节跳动原计划于 8 月推出的豆包大模型 2.2 将推迟面世。多位接近字节的人士称，延期的原因是，字节内部希望通过更充分的预训练和后训练，把编程、工具调用和 Agent 能力拉上去。用更长的研发周期换一次更明显的能力提升。Seed 现在同时面对两件事，一边要推进下一代超大模型，一边又不能停止现有模型的正常迭代。所以，2.2...","source": "IT之家","sourceUrl": "https://www.ithome.com/0/996/239.htm","category": "AI"},{"date": "2026-08-31","title": "比亚迪大六座 SUV 腾势 N8L 纯电版将于 9 月份上市，拥有 208L 智能电动前备箱","summary": "IT之家 8 月 30 日消息，比亚迪集团腾势汽车总经理李慧昨日透露，大六座安全豪华 SUV 腾势 N8L 纯电版将于 9 月份正式上市。海报显示，腾势 N8L 纯电版拥有 208L 智能电动前备箱。目前官方暂未公布更多新车信息，据IT之家此前报道，比亚迪腾势 N8L 于 2025 年 10 月 28 日上市，官方指导价 29.98 万元起。今年 6 月 23 日，比亚迪腾势 N8L...","source": "IT之家","sourceUrl": "https://www.ithome.com/0/996/234.htm","category": "AI"},{"date": "2026-08-31","title": "消息称 Meta 正测试数据中心机器人，可完成插拔线缆、重启服务器等运维工作","summary": "IT之家 8 月 30 日消息，据 Wired 报道，多位了解相关项目的 Meta 现任及前员工透露，Meta 正在测试能够在数据中心内插接线缆、重启服务器以及执行其他任务的机器人。这项此前未被报道的工作仍在进行中，未来可能让 Meta 以更少的人力运营不断扩张的数据中心，从而在人工智能基础设施投入不断飙升的情况下控制劳动力成本。上述知情人士表示，Meta...","source": "IT之家","sourceUrl": "https://www.ithome.com/0/996/222.htm","category": "AI"},{"date": "2026-08-31","title": "巴克莱研究：AI 模型公司每赚 100 美元，约 35 至 40 美元流向三大云巨头","summary": "IT之家 8 月 30 日消息，表面上看，人工智能（AI）模型公司似乎正在赚取巨额利润，但真正过得滋润的，可能是它们背后的云计算服务提供商。巴克莱银行最新研究拆解了 AI 产业链中的利润分配情况。研究发现，模型公司每创造 100 美元（IT之家注：现汇率约合 674.6 元人民币）营收，就有 35 至 40 美元（现汇率约合 236.1 至 269.8...","source": "IT之家","sourceUrl": "https://www.ithome.com/0/996/218.htm","category": "AI"},{"date": "2026-08-31","title": "华为 WATCH D3 智能手表参数曝光：屏幕增大至 1.92 英寸，厚度降至 11.4 毫米","summary": "IT之家 8 月 30 日消息，华为此前宣布，将于 9 月 2 日在德国慕尼黑举行全球发布会，发布全新 WATCH D3 智能手表。 科技媒体 WinFuture 今日爆料了这款新品的参数信息，WATCH D3 屏幕尺寸增大至 1.92 英寸（前代为 1.82 英寸），分辨率保持 480×408...","source": "IT之家","sourceUrl": "https://www.ithome.com/0/996/215.htm","category": "AI"},{"date": "2026-08-31","title": "东芝 S300 AI 系列机械硬盘开售：可选 8TB、10TB，2949 元起","summary": "IT之家 8 月 30 日消息，东芝 S300 AI 系列机械硬盘现已在京东开售，新品专为监控等场景设计，可选 8TB、10TB 容量，售价 2949 元起。据介绍，S300 AI 系列硬盘支持 RAID 磁盘阵列和 JBOD 应用，相比正常运行可降低能耗，同时确保驱动器在转瞬之间恢复运作。规格方面，该系列硬盘提供高达 550TB 年的年工作负载，平均故障间隔时间（MTTF）最高达 250...","source": "IT之家","sourceUrl": "https://www.ithome.com/0/996/213.htm","category": "AI"},{"date": "2026-08-31","title": "荣耀机器人闪电首次出海，成为马来西亚马拉松首位机器人参赛选手","summary": "IT之家 8 月 30 日消息，据荣耀全球首席营销官关海涛今日透露，荣耀机器人闪电继打破人类百米、半马纪录后首次出海，亮相马来西亚马拉松，成为赛事历史上第一位机器人参赛选手。关海涛表示，闪电在马来西亚双子塔璀璨夜色之下，顺利完成 10 公里赛程，刷新赛事纪录。IT之家查询互联网公开资料获悉，闪电是荣耀自研的人形机器人，它身高...","source": "IT之家","sourceUrl": "https://www.ithome.com/0/996/203.htm","category": "AI"},{"date": "2026-08-31","title": "华为云联合瑞金医院发布瑞智病理大模型 RuiPath 2.0：7B 参数，覆盖 19 个常见癌种","summary": "IT之家 8 月 30 日消息，瑞金医院今日联合华为云正式发布瑞智病理大模型 RuiPath 2.0，带来性能、诊断能力、病理诊断可解释性、罕见病种数据训练、轻量化部署五大升级。据介绍，本次发布的 RuiPath 2.0 模型参数规模为 7B，覆盖 19 个常见癌种，诊断任务增至 205 项，为业界最全，可覆盖病理医生 90%...","source": "IT之家","sourceUrl": "https://www.ithome.com/0/996/195.htm","category": "AI"},{"date": "2026-08-31","title": "英国电信行业高管警告：5G 升级太慢，英国可能输掉 AI 竞赛","summary": "IT之家 8 月 30 日消息，据《卫报》昨天报道，英国电信行业多位高管表示，如果英国电信基础设施升级进度持续落后于其他国家，可能在全球 AI 竞赛中落于下风。IT之家从原报道获悉，当前阶段的 AI 基础设施建设主要在数据中心方面。然而随着 AI 不断普及，英国的宽带和移动数据网络，需要承载消费者和企业的海量数据流量。英国曾因拥有欧洲最慢的宽带速度广受批评。如今随着 Openreach...","source": "IT之家","sourceUrl": "https://www.ithome.com/0/996/190.htm","category": "AI"},{"date": "2026-08-31","title": "机械革命翼龙 15 Air 2026 笔记本锐龙 7 H 449 版发布：RTX 5060，国补到手价 9999 元","summary": "IT之家 8 月 30 日消息，机械革命今日发布了新款翼龙 15 Air 2026 笔记本，搭载锐龙 7 H 449 处理器，日常价 13999 元、首发价 11499 元、国补到手价 9999 元。这款笔记本电脑将于 9 月 4 日开始预约，9 月 10 日开售，有云涧白、云杉青两种配色可选，配备 24GB LPDDR5X 双通道内存和 1TB PCIe 4.0 固态。这款新品搭载 RTX...","source": "IT之家","sourceUrl": "https://www.ithome.com/0/996/186.htm","category": "AI"},{"date": "2026-08-31","title": "全球仅 3 家能铸：马斯克 SpaceX 突破 AI 供电瓶颈，自产涡轮叶片提前 18 个月投运","summary": "IT之家 8 月 30 日消息，全球首富埃隆 · 马斯克（Elon Musk）今天（8 月 30 日）在 X 平台发布推文，确认 SpaceX 正筹划在美国得克萨斯州巴斯特罗普（Bastrop）建设一座燃气轮机动叶（blades）与静叶（vanes）铸造厂。blades 也称动叶，装在旋转部件（转子、叶轮）上，随轴一起转动，用来做功或传递能量；而 vanes...","source": "IT之家","sourceUrl": "https://www.ithome.com/0/996/179.htm","category": "AI"},{"date": "2026-08-31","title": "拿下中石油体系超百台订单，这家公司为特危化场景提供“巡操一体”机器人丨36氪首发","summary": "图源/企业 本文约2600字，建议阅读6分钟 作者丨欧雪 编辑丨袁斯来 硬氪获悉，特危化工业具身机器人公司——玄创机器人已完成数千万元A1轮融资，投资方包括前海方舟、光洋股份和西湖科创投。资金将主要用于数据管线搭建、VLA模型与JEPA世界模型的训练部署，以及标准化产品的备货与生产。 玄创机器人成立于2022年12月，长期深耕油气、化工等特危化工业场景，专注于特种具身智能机器人的发展与应用。...","source": "36氪","sourceUrl": "<![CDATA[https://36kr.com/p/3959929849642113?f=rss]]>","category": "AI"},{"date": "2026-08-31","title": "「聚焦太空内生价值」，算力上天的中国路径与现实切口｜OpenTalk回顾","summary": "8月26日，国务院新闻办公室举行新闻发布会，工业和信息化部介绍“十五五”时期加快推进新型工业化有关情况。会上明确，未来五年将加快打造航空航天、低空经济等新兴支柱产业，加快新一代通信网、算力网规划建设，加强6G技术研发。商业航天与算力基础设施的政策信号再一次密集释放。...","source": "36氪","sourceUrl": "<![CDATA[https://36kr.com/p/3959033085459844?f=rss]]>","category": "AI"},{"date": "2026-08-31","title": "36氪首发｜上科大团队做具身世界模型基础设施，完成千万美元种子轮融资","summary": "作者 | 乔钰杰 编辑 | 袁斯来 本文约3200字，建议阅读7分钟 硬氪获悉，具身智能基础设施公司「瞬适科技」（InstAdapt）近日完成千万美元种子轮融资，由协创智慧、云晖资本、浦东创投和吴越天使等机构联合投资，芯湃资本担任融资顾问。本轮资金将主要用于物理AI数据基础设施建设、具身世界模型研发以及核心团队扩充。 瞬适科技由上海科技大学团队孵化，定位于物理AI（Physical...","source": "36氪","sourceUrl": "<![CDATA[https://36kr.com/p/3957651741949056?f=rss]]>","category": "AI"},{"date": "2026-08-31","title": "中信证券：AI在Q2集中体现，而能化接下来可能逐步升温","summary": "中信证券研报指出，2022年后A股“结构性快速轮动”是常态，极高轮动速度持续时间一般在1~2个月，高速轮动背后的共性是盈利上修的广度不足，可持续的主线稀缺。当前，贸易摩擦步入高发期，汇兑损益的影响也在放大，出海作为A股最重要的业绩线索之一遭遇估值约束，制约了行情的宽度，容易形成行业快速轮动的市场状态。打破僵局需要新的变化，近期的AI进展强化了算力需求快速增长的既有趋势，但不足以改变远期商业化叙事，...","source": "36氪","sourceUrl": "<![CDATA[https://36kr.com/newsflashes/3961771463867779?f=rss]]>","category": "AI"},{"date": "2026-08-31","title": "腾讯、阿里等押注“揣摩人心”的智能体，Agent Memory从技术概念成长为行业赛道","summary": "腾讯、阿里等押注“揣摩人心”的智能体，Agent Memory从技术概念成长为行业赛道","source": "每日经济新闻","sourceUrl": "https://www.nbd.com.cn/articles/2026-08-30/4566177.html","category": "AI"},{"date": "2026-08-31","title": "观众为何能接受AI短剧和漫剧，却不能容忍长剧片头用AI？","summary": "观众为何能接受AI短剧和漫剧，却不能容忍长剧片头用AI？","source": "每日经济新闻","sourceUrl": "https://www.nbd.com.cn/articles/2026-07-26/4512224.html","category": "AI"},{"date": "2026-08-31","title": "OpenAI和Anthropic冲刺IPO，美国大模型降价冲击债市；达利欧：美国债务危机最快三年内爆发；现货黄金重回4600美元，比特币周涨逾24%；英伟达下周迎财报大考 | 一周国际财经","summary": "OpenAI和Anthropic冲刺IPO，美国大模型降价冲击债市；达利欧：美国债务危机最快三年内爆发；现货黄金重回4600美元，比特币周涨逾24%；英伟达下周迎财报大考 | 一周国际财经","source": "每日经济新闻","sourceUrl": "https://www.nbd.com.cn/articles/2026-08-22/4551139.html","category": "AI"},{"date": "2026-08-31","title": "AI芯片、服务器机架和数据中心正在“抢”飞机：亚洲至北美空运需求大涨14.7%，已连续5个月增长","summary": "AI芯片、服务器机架和数据中心正在“抢”飞机：亚洲至北美空运需求大涨14.7%，已连续5个月增长","source": "每日经济新闻","sourceUrl": "https://www.nbd.com.cn/articles/2026-08-20/4547703.html","category": "AI"},{"date": "2026-08-31","title": "美债收益率创19年新高背后：AI正和美国政府“抢钱”，美联邦债务恐提前突破40万亿美元，资金成本飙升冲击AI硬件股","summary": "美债收益率创19年新高背后：AI正和美国政府“抢钱”，美联邦债务恐提前突破40万亿美元，资金成本飙升冲击AI硬件股","source": "每日经济新闻","sourceUrl": "https://www.nbd.com.cn/articles/2026-08-19/4546170.html","category": "AI"},{"date": "2026-08-31","title": "安达智能拟零元收购实控人关联资产，收购标的净资产为负，且欠公司1050万元借款","summary": "安达智能拟零元收购实控人关联资产，收购标的净资产为负，且欠公司1050万元借款","source": "每日经济新闻","sourceUrl": "https://www.nbd.com.cn/articles/2026-08-28/4563882.html","category": "AI"},{"date": "2026-08-31","title": "下周重磅打新：国产AI芯片龙头，来了","summary": "按照目前的发行安排，下周（8月31日至9月4日）共有3只新股可申购：周一（8月31日）可申购北交所新股百迈科；周三（9月2日）可申购科创板新股燧原科技；周四（9月3日）可申购科创板新股信诺维。","source": "财联社","sourceUrl": "https://www.cls.cn/detail/2468702","category": "AI"},{"date": "2026-08-31","title": "洪田股份：并购落子特种机器人赛道 双向协同打造高端装备制造平台","summary": "公司方面指出，基于先进装备制造的产业共性，公司与国兴智能将打通全球客户与国际化渠道，实现资源双向赋能。","source": "财联社","sourceUrl": "https://www.cls.cn/detail/2468873","category": "AI"},{"date": "2026-08-31","title": "巴克莱拆解AI经济账：模型公司每赚100美元，云厂商拿走近40美元","summary": "①AI实验室付费推理利润率已由去年的低双位数升至50%至65%以上，API业务利润率更超过80%； ②随着训练成本占比下降及专属算力基础设施陆续上线，AI实验室盈利能力有望继续改善，三大云厂商份额则面临回落压力。","source": "财联社","sourceUrl": "https://www.cls.cn/detail/2468651","category": "AI"},{"date": "2026-08-31","title": "【明日主题前瞻】具身智能训练场成为关键基础设施，各地掀起建设热潮","summary": "①具身智能训练场成为关键基础设施，各地掀起建设热潮；②多地正加速布局国产词元工厂与智算综合体；③AI算力需求持续扩容叠加高速光模块技术迭代。","source": "财联社","sourceUrl": "https://www.cls.cn/detail/2467689","category": "AI"},{"date": "2026-08-31","title": "港股IPO周报：正泰电器等多家A股公司递表 AI基建软件商星环科技通过聆讯","summary": "①正泰电器等多家A股公司递表，哪些值得重点关注？ ②AI基建软件商星环科技通过聆讯，有何看点？","source": "财联社","sourceUrl": "https://www.cls.cn/detail/2468724","category": "AI"},{"date": "2026-08-31","title": "财联社创投通：一级市场本周融资总额约161.5亿元，小鹏机器人完成超9亿美元首轮融资","summary": "①本周（8.22-8.28）国内共发生136起投融资事件，已披露融资总额约161.50亿元。 ②先进制造、集成电路融资总额居前两位；细分赛道中AI基础设施等较活跃。 ③中金资本出资6次为本周最活跃投资机构；小鹏机器人完成超9亿美元首轮融资，为本周披露金额最高的投资事件。","source": "财联社","sourceUrl": "https://www.cls.cn/detail/2468717","category": "AI"},{"date": "2026-08-31","title": "AI数据中心扩张“限制性因素”浮现 马斯克：SpaceX正铸造燃气轮机叶片","summary": "①马斯克表示，通过在SpaceX内部进行叶片与导叶铸造，可以将燃气轮机的上线时间提前多达18个月； ②近几个月来，SpaceX发布了多则招聘信息：其中包括一位高级运营工程师，职责为“全面负责新建叶片铸造厂的选址建设、产能扩建与投产启动”。","source": "财联社","sourceUrl": "https://www.cls.cn/detail/2468847","category": "AI"},{"date": "2026-08-31","title": "硅谷头部风投，11亿美元专项基金押注AI硬件","summary": "硅谷头部风投，11亿美元专项基金押注AI硬件","source": "证券时报","sourceUrl": "https://www.stcn.com/article/detail/4162816.html","category": "AI"},{"date": "2026-08-31","title": "集齐CPO、人形机器人、汽车电子等热门题材，002475，这只龙头股火了（附名单）","summary": "集齐CPO、人形机器人、汽车电子等热门题材，002475，这只龙头股火了（附名单）","source": "证券时报","sourceUrl": "https://www.stcn.com/article/detail/4161579.html","category": "AI"},{"date": "2026-08-31","title": "汉朔科技：智能购物车已进入批量交付阶段","summary": "汉朔科技：智能购物车已进入批量交付阶段","source": "证券时报","sourceUrl": "https://www.stcn.com/article/detail/4162865.html","category": "AI"},{"date": "2026-08-31","title": "报告称AI公司每赚100美元近40美元流向云巨头","summary": "报告称AI公司每赚100美元近40美元流向云巨头","source": "证券时报","sourceUrl": "https://www.stcn.com/article/detail/4162830.html","category": "AI"},{"date": "2026-08-31","title": "人民鉴真165期丨算力卡被卡在海关？行云科技：相关传言不实","summary": "人民鉴真165期丨算力卡被卡在海关？行云科技：相关传言不实","source": "证券时报","sourceUrl": "https://www.stcn.com/article/detail/4070071.html","category": "AI"},{"date": "2026-08-31","title": "AI驱动健管升级 美年健康上半年营收38.44亿元","summary": "AI驱动健管升级 美年健康上半年营收38.44亿元","source": "证券时报","sourceUrl": "https://www.stcn.com/article/detail/4162831.html","category": "AI"},{"date": "2026-08-31","title": "7连板后，000017公告：无AI业务收入","summary": "7连板后，000017公告：无AI业务收入","source": "证券时报","sourceUrl": "https://www.stcn.com/article/detail/4162828.html","category": "AI"},{"date": "2026-08-31","title": "佳禾智能半年报营收同比增长13.19% 并购拜亚动力开启品牌化跃迁","summary": "佳禾智能半年报营收同比增长13.19% 并购拜亚动力开启品牌化跃迁","source": "证券时报","sourceUrl": "https://www.stcn.com/article/detail/4162783.html","category": "AI"},{"date": "2026-08-31","title": "当AI“善解人意”，请多一分清醒（科技大观）","summary": "当AI“善解人意”，请多一分清醒（科技大观）","source": "证券时报","sourceUrl": "https://www.stcn.com/article/detail/4149305.html","category": "AI"},{"date": "2026-08-31","title": "勿用短期K线定义人形机器人的未来","summary": "勿用短期K线定义人形机器人的未来","source": "证券时报","sourceUrl": "https://www.stcn.com/article/detail/4149231.html","category": "AI"},{"date": "2026-08-31","title": "词元经济催生AI基础设施新需求 国内厂商以存算协同破局","summary": "词元经济催生AI基础设施新需求 国内厂商以存算协同破局","source": "证券时报","sourceUrl": "https://www.stcn.com/article/detail/4150304.html","category": "AI"},{"date": "2026-08-31","title": "绿色算力开启“双向奔赴”新范式","summary": "绿色算力开启“双向奔赴”新范式","source": "证券时报","sourceUrl": "https://www.stcn.com/article/detail/4126116.html","category": "AI"},{"date": "2026-08-31","title": "多家互联网大厂，联手投了一家AI机器人公司","summary": "多家互联网大厂，联手投了一家AI机器人公司","source": "证券时报","sourceUrl": "https://www.stcn.com/article/detail/4161509.html","category": "AI"},{"date": "2026-08-31","title": "解读三大供应链龙头半年报：AI驱动，主业修复","summary": "解读三大供应链龙头半年报：AI驱动，主业修复","source": "证券时报","sourceUrl": "https://www.stcn.com/article/detail/4161561.html","category": "AI"},{"date": "2026-08-31","title": "多家企业连续涨停！&quot;Token经济&quot;能让算力租赁火多久？","summary": "多家企业连续涨停！&quot;Token经济&quot;能让算力租赁火多久？","source": "证券时报","sourceUrl": "https://www.stcn.com/article/detail/4038271.html","category": "AI"},{"date": "2026-08-31","title": "支付行业拐点已至：跨境业务加速，AI支付兑现，行业有望重估","summary": "2026年上半年，支付行业经历了过去三年未见的拐点性变化：银行卡消费在连续7个季度同比负增长后首次转正，支付牌照存量从峰值271张锐减至不足180张且不再新发。","source": "华尔街见闻","sourceUrl": "https://wallstreetcn.com/articles/3778839","category": "AI"},{"date": "2026-08-31","title": "顶尖风投a16z：顶尖人才涌向AI基建，基础设施设计将“推倒重来”","summary": "a16z核心合伙人认为，随着巨头明年CapEx预估迈向1万亿美元，GPU和存储等核心硬件订单已排至2028年。由于现有计算架构逼近物理极限，机架功率激增数十倍，数据中心的芯片、电力（转向800V直流电）和液冷系统正面临“推倒重来”的全面重构。顶尖创业者涌入硬件的比例已从不足5%跃升至20%至30%以上。","source": "华尔街见闻","sourceUrl": "https://wallstreetcn.com/articles/3780656","category": "AI"},{"date": "2026-08-31","title": "250年历史复盘：AI资本开支泡沫离破裂还有多远","summary": "历史“25法则”表明，技术支出达经济产出25%前极少崩盘。目前AI投入远未触及红线，这场狂欢远比想象中持久。","source": "华尔街见闻","sourceUrl": "https://wallstreetcn.com/articles/3780654","category": "AI"},{"date": "2026-08-31","title": "OpenAI新王Astra首测曝光，前端不存在了？","summary": "前端要被OpenAI端了？新模型Astra内测曝光，零样本直出复杂3D网页！凭借多智能体与自纠错等核心技术，彻底实现“想法碾压执行”。传Astra将于9月初发布，以极高性价比正面硬刚Fable 5.1，AI编程新王之战一触即发！","source": "华尔街见闻","sourceUrl": "https://wallstreetcn.com/articles/3780645","category": "AI"},{"date": "2026-08-31","title": "陕西制定清单明确政府投资基金投向 加速科技成果转化与产业链延链补链强链","summary": "陕西制定清单明确政府投资基金投向 加速科技成果转化与产业链延链补链强链","source": "新浪新闻","sourceUrl": "https://news.sina.com.cn/zx/gj/2026-08-30/doc-iniqaqpt5058216.shtml","category": "量化"},{"date": "2026-08-31","title": "营收增长83%、扣非仍亏损，长光华芯归母净利增长238%主要靠光子基金公允价值变动","summary": "营收增长83%、扣非仍亏损，长光华芯归母净利增长238%主要靠光子基金公允价值变动","source": "每日经济新闻","sourceUrl": "https://www.nbd.com.cn/articles/2026-08-30/4566635.html","category": "量化"},{"date": "2026-08-31","title": "科研用生物试剂制造商碧云天闯关科创板：第一大客户突现变数，两年仅新增一项发明专利授权","summary": "科研用生物试剂制造商碧云天闯关科创板：第一大客户突现变数，两年仅新增一项发明专利授权","source": "每日经济新闻","sourceUrl": "https://www.nbd.com.cn/articles/2026-08-30/4566106.html","category": "量化"},{"date": "2026-08-31","title": "专访｜广东省房地产行业协会会长王韶：现房模式大幅抬高行业准入门槛，房企融资开发逻辑将迎来重构","summary": "专访｜广东省房地产行业协会会长王韶：现房模式大幅抬高行业准入门槛，房企融资开发逻辑将迎来重构","source": "每日经济新闻","sourceUrl": "https://www.nbd.com.cn/articles/2026-08-30/4566415.html","category": "量化"},{"date": "2026-08-31","title": "最近1个月A股定增图谱：大股东高比例认购的公司股价表现强势，大千生态成唯一“破发股”","summary": "最近1个月A股定增图谱：大股东高比例认购的公司股价表现强势，大千生态成唯一“破发股”","source": "每日经济新闻","sourceUrl": "https://www.nbd.com.cn/articles/2026-08-29/4565793.html","category": "量化"},{"date": "2026-08-31","title": "市场反弹可能持续到9月下旬？十大券商策略来了","summary": "十大券商最新策略观点精要+看好板块汇总梳理。","source": "财联社","sourceUrl": "https://www.cls.cn/detail/2468879","category": "量化"},{"date": "2026-08-31","title": "最能赚钱的基金公司换位了，也有黑马一次提升14名冲进前20","summary": "①上半年净利润前20的基金管理人中，20亿净利阵营有3家，业绩冠军得主换人； ②部分基金公司净利润排名提升特别显著，TOP20机构中有出现排名提升14个位次的情况； ③部分机构净利润增幅远超营收，增幅最多的增近10倍。","source": "财联社","sourceUrl": "https://www.cls.cn/detail/2468731","category": "量化"},{"date": "2026-08-31","title": "侵占、挪用基金资产908万，又无力偿债，这家私募把自己推向了终点","summary": "①股权类私募四川商投资本，存在侵占、挪用908万元基金财产的违规行为，该私募及董事长各被罚款6万元； ②穿透股权，该私募具备四川省国资背景，且由“复星系”间接参股； ③该私募因资不抵债，975万到期债务无力清偿，已进入破产清算程序。","source": "财联社","sourceUrl": "https://www.cls.cn/detail/2468791","category": "量化"},{"date": "2026-08-31","title": "久违的QDII额度新批！基金公司获30亿美元增量，热门QDII又可开门迎客","summary": "①8月QDII新增68.4亿美元，证券基金类占37.2亿，系2021年6月来最多。 ②39家公募增额，鑫元首次获批1亿。 ③多只纳指/半导体QDII长期限购，新额度有望松绑，缓解场内高溢价。","source": "财联社","sourceUrl": "https://www.cls.cn/detail/2468740","category": "量化"},{"date": "2026-08-31","title": "公募基金“中考”放榜！这家机构登顶，行业分化与黑马突围并行","summary": "公募基金“中考”放榜！这家机构登顶，行业分化与黑马突围并行","source": "证券时报","sourceUrl": "https://www.stcn.com/article/detail/4161852.html","category": "量化"},{"date": "2026-08-31","title": "半年报新动向！多位牛散进驻A股银行，什么信号？","summary": "半年报新动向！多位牛散进驻A股银行，什么信号？","source": "证券时报","sourceUrl": "https://www.stcn.com/article/detail/4161693.html","category": "量化"},{"date": "2026-08-31","title": "今夜！A股，又现大手笔分红","summary": "今夜！A股，又现大手笔分红","source": "证券时报","sourceUrl": "https://www.stcn.com/article/detail/4162824.html","category": "量化"},{"date": "2026-08-31","title": "依靠主动ETF“提